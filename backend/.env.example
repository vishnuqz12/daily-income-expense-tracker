# PostgreSQL connection string. For Supabase, copy the SESSION POOLER connection string.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres

# Comma-separated frontend origins. Keep localhost for local development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://YOUR-FRONTEND.onrender.com

# PostgreSQL SSL mode. "require" is recommended for hosted databases.
DB_SSLMODE=require

# Optional tuning / security settings.
SESSION_DAYS=30
PBKDF2_ITERATIONS=220000
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=300
